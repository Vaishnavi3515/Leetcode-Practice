class Solution {
public:
    vector<int> maxSlidingWindow(vector<int>& arr, int k) {
        int n = arr.size();
        vector<int> ngi(n);
        stack<int> st;

        // Build Next Greater Index array
        ngi[n-1] = n;
        st.push(n-1);
        for(int i = n-2; i >= 0; i--) {
            while(!st.empty() && arr[st.top()] <= arr[i]) {
                st.pop();
            }
            ngi[i] = (st.empty() ? n : st.top());
            st.push(i); //push current index back
        }

        vector<int> ans;
        for(int i = 0; i <= n-k; i++) {
            int j = i;
            while(ngi[j] < i+k) { // while next greater is inside window
                j = ngi[j];
            }
            ans.push_back(arr[j]); // arr[j] is max in window
        }
        return ans;
    }
};
 
